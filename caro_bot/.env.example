# Copie ce fichier en .env et remplis-le. Ne mets JAMAIS le .env sur GitHub.

# Token donné par @BotFather dans Telegram
TELEGRAM_BOT_TOKEN=

# Ton identifiant Telegram (un nombre). Laisse vide au début : /start te le donne.
TELEGRAM_OWNER_ID=

# Clé API de https://platform.claude.com
ANTHROPIC_API_KEY=

# Mot de passe de l'application web Black Box (long, 16 caractères ou plus)
APP_PASSWORD=

# Optionnel : 3Commas en LECTURE SEULE (clé créée avec la permission Read only)
THREECOMMAS_API_KEY=
THREECOMMAS_API_SECRET=

# Optionnel : cerveau de secours Ollama Cloud (clé de ollama.com), utilisé seulement si Claude est indisponible
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Optionnel : interrupteur d'urgence /stop (arrête VRAIMENT les bots)
# Une 2e clé 3Commas, séparée de celle en lecture : permissions « Bots read » + « Bots write », SANS trading manuel ni retrait
THREECOMMAS_KILL_API_KEY=
THREECOMMAS_KILL_API_SECRET=
# Et/ou ton bot Freqtrade (API REST activée)
FREQTRADE_URL=
FREQTRADE_USER=
FREQTRADE_PASSWORD=

# Optionnel : publication quotidienne d'ECHO (CARO doit être admin de la chaîne)
PROMO_CHANNEL=
PROMO_TIME=09:00
# La fiche du projet : soit le fichier promo_brief.md, soit tout le texte ici
PROMO_BRIEF=

# Optionnel
CARO_MODEL=claude-opus-5-5
CARO_EFFORT=low
CARO_TZ=America/Toronto
# Sur Railway, avec un volume monté sur /data :
# CARO_DB=/data/caro.db
